package postgres

import (
	"context"
	"errors"
	"fmt"
	"time"

	"github.com/google/uuid"
	"github.com/jackc/pgx/v5"
	"github.com/jackc/pgx/v5/pgxpool"

	"{{.Config.Project.Module}}/internal/domain"
)

type AuthRepository struct{ pool *pgxpool.Pool }
func NewAuthRepository(pool *pgxpool.Pool)*AuthRepository{return &AuthRepository{pool:pool}}

func(r *AuthRepository)FindUserByEmail(ctx context.Context,email string)(domain.AuthUser,error){
	var user domain.AuthUser
	err:=r.pool.QueryRow(ctx,`SELECT id,email,password_hash,roles,active FROM users WHERE email=$1`,email).Scan(&user.ID,&user.Email,&user.PasswordHash,&user.Roles,&user.Active)
	if errors.Is(err,pgx.ErrNoRows){return domain.AuthUser{},domain.ErrInvalidCredentials};if err!=nil{return domain.AuthUser{},fmt.Errorf("find auth user: %w",err)};return user,nil
}
func(r *AuthRepository)CreateSession(ctx context.Context,s domain.AuthSession)error{_,err:=r.pool.Exec(ctx,`INSERT INTO auth_sessions(id,user_id,refresh_token_hash,expires_at,created_at) VALUES($1,$2,$3,$4,$5)`,s.ID,s.UserID,s.TokenHash,s.ExpiresAt,s.CreatedAt);if err!=nil{return fmt.Errorf("create auth session: %w",err)};return nil}
func(r *AuthRepository)RotateSession(ctx context.Context,oldHash []byte,next domain.AuthSession)(domain.AuthUser,error){
	tx,err:=r.pool.Begin(ctx);if err!=nil{return domain.AuthUser{},fmt.Errorf("begin refresh rotation: %w",err)};defer func(){_ = tx.Rollback(ctx)}()
	var user domain.AuthUser;var sessionID uuid.UUID;var expires time.Time;var revokedAt,rotatedAt *time.Time
	err=tx.QueryRow(ctx,`SELECT s.id,s.user_id,s.expires_at,s.revoked_at,s.rotated_at,u.email,u.password_hash,u.roles,u.active FROM auth_sessions s JOIN users u ON u.id=s.user_id WHERE s.refresh_token_hash=$1 FOR UPDATE`,oldHash).Scan(&sessionID,&user.ID,&expires,&revokedAt,&rotatedAt,&user.Email,&user.PasswordHash,&user.Roles,&user.Active)
	if errors.Is(err,pgx.ErrNoRows){return domain.AuthUser{},domain.ErrInvalidRefreshToken};if err!=nil{return domain.AuthUser{},fmt.Errorf("lock auth session: %w",err)}
	if revokedAt!=nil||rotatedAt!=nil { _,_ = tx.Exec(ctx,`UPDATE auth_sessions SET revoked_at=NOW() WHERE user_id=$1 AND revoked_at IS NULL`,user.ID);_ = tx.Commit(ctx);return domain.AuthUser{},domain.ErrRefreshTokenReuse }
	if time.Now().After(expires)||!user.Active{return domain.AuthUser{},domain.ErrInvalidRefreshToken}
	next.UserID=user.ID;now:=time.Now();_,err=tx.Exec(ctx,`UPDATE auth_sessions SET rotated_at=$2,revoked_at=$2 WHERE id=$1`,sessionID,now);if err!=nil{return domain.AuthUser{},fmt.Errorf("rotate old session: %w",err)}
	_,err=tx.Exec(ctx,`INSERT INTO auth_sessions(id,user_id,refresh_token_hash,expires_at,created_at,rotated_from) VALUES($1,$2,$3,$4,$5,$6)`,next.ID,next.UserID,next.TokenHash,next.ExpiresAt,next.CreatedAt,sessionID);if err!=nil{return domain.AuthUser{},fmt.Errorf("insert rotated session: %w",err)}
	if err:=tx.Commit(ctx);err!=nil{return domain.AuthUser{},fmt.Errorf("commit refresh rotation: %w",err)};return user,nil
}
func(r *AuthRepository)RevokeSession(ctx context.Context,hash []byte)error{tag,err:=r.pool.Exec(ctx,`UPDATE auth_sessions SET revoked_at=NOW() WHERE refresh_token_hash=$1 AND revoked_at IS NULL`,hash);if err!=nil{return fmt.Errorf("revoke auth session: %w",err)};if tag.RowsAffected()==0{return domain.ErrInvalidRefreshToken};return nil}
