package httpserver

import (
	"log/slog"
	"net/http"
	"time"

	"github.com/go-chi/chi/v5/middleware"
	oteltrace "go.opentelemetry.io/otel/trace"
)

type statusWriter struct{http.ResponseWriter;status int;bytes int}
func(w *statusWriter)WriteHeader(status int){w.status=status;w.ResponseWriter.WriteHeader(status)}
func(w *statusWriter)Write(value []byte)(int,error){if w.status==0{w.WriteHeader(http.StatusOK)};n,err:=w.ResponseWriter.Write(value);w.bytes+=n;return n,err}
func requestLogging(logger *slog.Logger)func(http.Handler)http.Handler{return func(next http.Handler)http.Handler{return http.HandlerFunc(func(w http.ResponseWriter,r *http.Request){start:=time.Now();writer:=&statusWriter{ResponseWriter:w,status:http.StatusOK};next.ServeHTTP(writer,r);attrs:=[]any{"request_id",middleware.GetReqID(r.Context()),"method",r.Method,"path",r.URL.Path,"status",writer.status,"bytes",writer.bytes,"duration_ms",time.Since(start).Milliseconds()};span:=oteltrace.SpanFromContext(r.Context()).SpanContext();if span.IsValid(){attrs=append(attrs,"trace_id",span.TraceID().String())};logger.Info("http request",attrs...)})}}
