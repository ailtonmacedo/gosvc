package postgres
import("context";"errors";"fmt";"time";"gorm.io/gorm";"{{.Config.Project.Module}}/internal/domain";"{{.Config.Project.Module}}/internal/ports")
var _ ports.OrderRepository=(*OrderRepository)(nil)
type orderModel struct{ID int64 `gorm:"column:id;primaryKey;autoIncrement"`;Status string `gorm:"column:status"`;TotalCents int64 `gorm:"column:total_cents"`;CreatedAt time.Time `gorm:"column:created_at;autoCreateTime"`;UpdatedAt time.Time `gorm:"column:updated_at;autoUpdateTime"`}
func(orderModel)TableName()string{return "orders"}
type OrderRepository struct{db *gorm.DB}
func NewOrderRepository(pool *Pool)*OrderRepository{return &OrderRepository{db:pool.DB}}
func(r *OrderRepository)Create(ctx context.Context,v domain.Order)(domain.Order,error){m:=orderModel{Status:v.Status,TotalCents:v.TotalCents};if err:=r.db.WithContext(ctx).Create(&m).Error;err!=nil{return domain.Order{},fmt.Errorf("insert order: %w",err)};return orderToDomain(m),nil}
func(r *OrderRepository)GetByID(ctx context.Context,id int64)(domain.Order,error){var m orderModel;err:=r.db.WithContext(ctx).First(&m,"id = ?",id).Error;if errors.Is(err,gorm.ErrRecordNotFound){return domain.Order{},domain.ErrOrderNotFound};if err!=nil{return domain.Order{},fmt.Errorf("select order %d: %w",id,err)};return orderToDomain(m),nil}
func(r *OrderRepository)List(ctx context.Context,limit,offset int32)([]domain.Order,error){var models []orderModel;if err:=r.db.WithContext(ctx).Order("id").Limit(int(limit)).Offset(int(offset)).Find(&models).Error;err!=nil{return nil,fmt.Errorf("list orders: %w",err)};out:=make([]domain.Order,0,len(models));for _,m:=range models{out=append(out,orderToDomain(m))};return out,nil}
func(r *OrderRepository)Update(ctx context.Context,v domain.Order)(domain.Order,error){m:=orderModel{ID:v.ID};result:=r.db.WithContext(ctx).Model(&m).Updates(map[string]any{"status":v.Status,"total_cents":v.TotalCents});if result.Error!=nil{return domain.Order{},fmt.Errorf("update order %d: %w",v.ID,result.Error)};if result.RowsAffected==0{return domain.Order{},domain.ErrOrderNotFound};return r.GetByID(ctx,v.ID)}
func(r *OrderRepository)Delete(ctx context.Context,id int64)error{result:=r.db.WithContext(ctx).Delete(&orderModel{},id);if result.Error!=nil{return fmt.Errorf("delete order %d: %w",id,result.Error)};if result.RowsAffected==0{return domain.ErrOrderNotFound};return nil}
func orderToDomain(m orderModel)domain.Order{return domain.Order{ID:m.ID,Status:m.Status,TotalCents:m.TotalCents,CreatedAt:m.CreatedAt,UpdatedAt:m.UpdatedAt}}
