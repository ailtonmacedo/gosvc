//go:build integration
package integration
import("context";"os";"testing";"time";"{{.Config.Project.Module}}/internal/config";"{{.Config.Project.Module}}/internal/domain";"{{.Config.Project.Module}}/internal/infrastructure/persistence/postgres")
func TestOrderRepository(t *testing.T){url:=os.Getenv("DATABASE_URL");if url==""{t.Skip("DATABASE_URL is not set")};ctx,cancel:=context.WithTimeout(context.Background(),10*time.Second);t.Cleanup(cancel);pool,err:=postgres.OpenPool(ctx,config.DatabaseConfig{Enabled:true,URL:url,MaxConns:4,MaxConnLifetime:time.Minute,MaxConnIdleTime:time.Minute,HealthCheckPeriod:time.Minute,QueryTimeout:3*time.Second});if err!=nil{t.Fatal(err)};t.Cleanup(pool.Close);repository:=postgres.NewOrderRepository(pool);created,err:=repository.Create(ctx,domain.Order{Status:"created",TotalCents:1500});if err!=nil{t.Fatal(err)};if created.ID==0{t.Fatal("created order ID is zero")};loaded,err:=repository.GetByID(ctx,created.ID);if err!=nil{t.Fatal(err)};if loaded.TotalCents!=created.TotalCents{t.Fatalf("total cents=%d want=%d",loaded.TotalCents,created.TotalCents)};if err:=repository.Delete(ctx,created.ID);err!=nil{t.Fatal(err)}}
