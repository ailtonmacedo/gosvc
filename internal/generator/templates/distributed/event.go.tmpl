package domain

import (
	"encoding/json"
	"time"

	"github.com/google/uuid"
)

// Event is the persistence-neutral representation of a domain event.
type Event struct {
	ID            uuid.UUID
	AggregateType string
	AggregateID   string
	Type          string
	Topic         string
	Payload       json.RawMessage
	OccurredAt    time.Time
	Attempts      int
}
