package bootstrap

import (
	"context"
	"errors"
	"fmt"
	"log/slog"
	"os"
	"os/signal"
	"syscall"

	"{{.Config.Project.Module}}/internal/application"
	"{{.Config.Project.Module}}/internal/config"
	"{{.Config.Project.Module}}/internal/infrastructure/messaging/kafka"
	"{{.Config.Project.Module}}/internal/infrastructure/persistence/postgres"
)

func RunWorker(parent context.Context, build BuildInfo) error {
	cfg, err := config.Load(); if err != nil { return fmt.Errorf("load configuration: %w", err) }
	logger := slog.New(slog.NewJSONHandler(os.Stdout, nil)).With("service", cfg.AppName+"-worker", "version", build.Version, "commit", build.Commit)
	ctx, stop := signal.NotifyContext(parent, os.Interrupt, syscall.SIGTERM); defer stop()
	pool, err := postgres.OpenPool(ctx, cfg.Database); if err != nil { return err }; defer pool.Close()
	publisher, err := kafka.OpenPublisher(cfg.Messaging.Brokers); if err != nil { return err }; defer publisher.Close()
	if err := publisher.Ping(ctx); err != nil { return fmt.Errorf("ping Kafka: %w", err) }
	worker := application.NewOutboxWorker(postgres.NewOutboxRepository(pool), publisher, application.OutboxWorkerConfig{PollInterval: cfg.Outbox.PollInterval, BatchSize: cfg.Outbox.BatchSize, MaxAttempts: cfg.Outbox.MaxAttempts, DLQSuffix: cfg.Messaging.DLQSuffix}, logger)
	logger.Info("outbox worker started")
	err = worker.Run(ctx)
	if errors.Is(err, context.Canceled) { return nil }
	return err
}
