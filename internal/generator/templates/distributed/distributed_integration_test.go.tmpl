//go:build integration

package integration

import (
	"context"
	"os"
	"strings"
	"testing"
	"time"

	"{{.Config.Project.Module}}/internal/config"
	redisstore "{{.Config.Project.Module}}/internal/infrastructure/cache/redis"
	"{{.Config.Project.Module}}/internal/infrastructure/messaging/kafka"
)

type integrationHandler struct { received chan []byte; err error }
func (h *integrationHandler) Handle(_ context.Context, _ string, payload []byte) error {
	if h.err == nil {
		select { case h.received <- append([]byte(nil), payload...): default: }
	}
	return h.err
}

func TestRedisIdempotencyStore(t *testing.T) {
	address := os.Getenv("REDIS_ADDRESS")
	if address == "" { t.Skip("REDIS_ADDRESS is required") }
	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second); defer cancel()
	store, err := redisstore.Open(ctx, config.CacheConfig{Enabled:true, Address:address})
	if err != nil { t.Fatal(err) }
	defer store.Close()
	key := "certification:"+time.Now().UTC().Format("20060102150405.000000000")
	acquired, err := store.Acquire(ctx,key,time.Minute); if err != nil || !acquired { t.Fatalf("first acquire=%v err=%v",acquired,err) }
	acquired, err = store.Acquire(ctx,key,time.Minute); if err != nil || acquired { t.Fatalf("duplicate acquire=%v err=%v",acquired,err) }
	if err := store.Release(ctx,key); err != nil { t.Fatal(err) }
	acquired, err = store.Acquire(ctx,key,time.Minute); if err != nil || !acquired { t.Fatalf("acquire after release=%v err=%v",acquired,err) }
}

func TestKafkaPublishConsume(t *testing.T) {
	brokersRaw := os.Getenv("KAFKA_BROKERS")
	if brokersRaw == "" { t.Skip("KAFKA_BROKERS is required") }
	brokers := strings.Split(brokersRaw,",")
	ctx, cancel := context.WithTimeout(context.Background(), 20*time.Second); defer cancel()
	publisher, err := kafka.OpenPublisher(brokers); if err != nil { t.Fatal(err) }; defer publisher.Close()
	if err := publisher.Ping(ctx); err != nil { t.Fatal(err) }

	topic := "certification.integration"
	group := "certification-"+time.Now().UTC().Format("150405.000000000")
	consumer, err := kafka.OpenConsumer(brokers,group,[]string{topic},publisher,nil,1,10*time.Millisecond,".dlq")
	if err != nil { t.Fatal(err) }; defer consumer.Close()
	handler := &integrationHandler{received:make(chan []byte,1)}
	done := make(chan error,1); go func(){done<-consumer.Run(ctx,handler)}()
	time.Sleep(500*time.Millisecond)
	if err := publisher.Publish(ctx,topic,"key",[]byte(`{"integration":true}`)); err != nil { t.Fatal(err) }
	select {
	case payload := <-handler.received:
		if !strings.Contains(string(payload),"integration") { t.Fatalf("payload=%s",payload) }
	case err := <-done:
		if err != nil && ctx.Err()==nil { t.Fatalf("consumer: %v",err) }
	case <-ctx.Done():
		t.Fatal("timed out waiting for Kafka message")
	}
}
