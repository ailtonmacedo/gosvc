APP_NAME := {{.Config.Project.Name}}
VERSION ?= dev
COMMIT ?= $(shell git rev-parse --short HEAD 2>/dev/null || echo unknown)
BUILD_TIME ?= $(shell date -u +%Y-%m-%dT%H:%M:%SZ)
LDFLAGS := -s -w -X main.version=$(VERSION) -X main.commit=$(COMMIT) -X main.buildTime=$(BUILD_TIME)
COVERAGE_MINIMUM ?= {{.Config.Quality.Coverage.Minimum}}
TOOLS_DIR := $(CURDIR)/bin
GOLANGCI_LINT := $(TOOLS_DIR)/golangci-lint
GOVULNCHECK := $(TOOLS_DIR)/govulncheck
GOLANGCI_LINT_VERSION := v2.12.2
GOVULNCHECK_VERSION := v1.6.0
{{if ne .Preset.Name "minimal-api"}}SQLC := $(TOOLS_DIR)/sqlc
MIGRATE := $(TOOLS_DIR)/migrate
OAPI_CODEGEN := $(TOOLS_DIR)/oapi-codegen
SQLC_VERSION := v1.30.0
MIGRATE_VERSION := v4.19.1
OAPI_CODEGEN_VERSION := v2.8.0
{{end}}
.PHONY: run{{if eq .Preset.Name "event-driven-api"}} run-worker k8s-validate k8s-apply{{end}} fmt format-check test test-race coverage coverage-check vet tidy tidy-check lint vulncheck verify build clean docker-build tools{{if ne .Preset.Name "minimal-api"}} generate generate-check migrate-up migrate-down migrate-version docker-up docker-down test-integration{{end}}

run:
	go run ./cmd/api
{{if eq .Preset.Name "event-driven-api"}}
run-worker:
	go run ./cmd/worker

k8s-validate:
	kubectl apply --dry-run=client -f deployments/k8s

k8s-apply:
	kubectl apply -f deployments/k8s
{{end}}

fmt:
	gofmt -w $$(find . -name '*.go' -not -path './vendor/*')

format-check:
	test -z "$$(gofmt -l .)"

test:
	go test ./...

test-race:
	go test -race ./...

coverage:
	go test -covermode=atomic -coverprofile=coverage.out ./...

coverage-check: coverage
	COVERAGE_MINIMUM=$(COVERAGE_MINIMUM) ./scripts/check-coverage.sh coverage.out

vet:
	go vet ./...

tidy:
	go mod tidy

tidy-check:
	go mod tidy
	git diff --exit-code -- go.mod go.sum
	test -z "$$(git status --porcelain -- go.mod go.sum)"

lint: $(GOLANGCI_LINT)
	$(GOLANGCI_LINT) run

vulncheck: $(GOVULNCHECK)
	$(GOVULNCHECK) ./...

verify: format-check tidy-check{{if ne .Preset.Name "minimal-api"}} generate-check{{end}} vet lint test coverage-check test-race vulncheck build

build:
	mkdir -p bin
	go build -trimpath -ldflags="$(LDFLAGS)" -o bin/$(APP_NAME) ./cmd/api
{{if eq .Preset.Name "event-driven-api"}}	go build -trimpath -ldflags="$(LDFLAGS)" -o bin/$(APP_NAME)-worker ./cmd/worker
{{end}}

docker-build:
	docker build --build-arg VERSION=$(VERSION) --build-arg COMMIT=$(COMMIT) --build-arg BUILD_TIME=$(BUILD_TIME) -t $(APP_NAME):$(VERSION) .
{{if eq .Preset.Name "event-driven-api"}}	docker build -f Dockerfile.migrate -t $(APP_NAME)-migrate:$(VERSION) .
{{end}}

tools:
	mkdir -p $(TOOLS_DIR)
	GOBIN=$(TOOLS_DIR) go install github.com/golangci/golangci-lint/v2/cmd/golangci-lint@$(GOLANGCI_LINT_VERSION)
	GOBIN=$(TOOLS_DIR) go install golang.org/x/vuln/cmd/govulncheck@$(GOVULNCHECK_VERSION)
{{if ne .Preset.Name "minimal-api"}}	GOBIN=$(TOOLS_DIR) go install github.com/sqlc-dev/sqlc/cmd/sqlc@$(SQLC_VERSION)
	GOBIN=$(TOOLS_DIR) go install -tags 'postgres' github.com/golang-migrate/migrate/v4/cmd/migrate@$(MIGRATE_VERSION)
	GOBIN=$(TOOLS_DIR) go install github.com/oapi-codegen/oapi-codegen/v2/cmd/oapi-codegen@$(OAPI_CODEGEN_VERSION)
{{end}}

$(GOLANGCI_LINT):
	$(MAKE) tools

$(GOVULNCHECK):
	$(MAKE) tools
{{if ne .Preset.Name "minimal-api"}}
generate: $(SQLC) $(OAPI_CODEGEN)
	$(OAPI_CODEGEN) --config api/oapi-codegen.yaml api/openapi.yaml
	$(SQLC) generate

generate-check: generate
	git diff --exit-code -- internal/generated api/openapi.yaml
	test -z "$$(git status --porcelain -- internal/generated api/openapi.yaml)"

$(SQLC):
	$(MAKE) tools

$(MIGRATE):
	$(MAKE) tools

$(OAPI_CODEGEN):
	$(MAKE) tools

migrate-up: $(MIGRATE)
	test -n "$$DATABASE_URL"
	$(MIGRATE) -path db/migrations -database "$$DATABASE_URL" up

migrate-down: $(MIGRATE)
	test -n "$$DATABASE_URL"
	$(MIGRATE) -path db/migrations -database "$$DATABASE_URL" down 1

migrate-version: $(MIGRATE)
	test -n "$$DATABASE_URL"
	$(MIGRATE) -path db/migrations -database "$$DATABASE_URL" version

test-integration:
	go test -tags=integration ./tests/integration/...

docker-up:
	docker compose up --build

docker-down:
	docker compose down
{{end}}
clean:
	rm -rf bin coverage.out coverage.filtered.out
