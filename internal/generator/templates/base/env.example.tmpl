APP_NAME={{.Config.Project.Name}}
APP_ENV=development
HTTP_PORT={{.Config.API.Port}}
HTTP_READ_TIMEOUT={{.Config.API.ReadTimeout}}
HTTP_WRITE_TIMEOUT={{.Config.API.WriteTimeout}}
HTTP_IDLE_TIMEOUT={{.Config.API.IdleTimeout}}
HTTP_SHUTDOWN_TIMEOUT={{.Config.API.ShutdownTimeout}}
HTTP_MAX_BODY_SIZE={{.Config.API.MaxBodySize}}
{{if ne .Preset.Name "minimal-api"}}
DATABASE_URL=postgres://postgres:postgres@localhost:5432/{{.Config.Project.Name}}?sslmode=disable
DATABASE_POOL_MAX_CONNS=20
DATABASE_POOL_MIN_CONNS=2
DATABASE_POOL_MAX_CONN_LIFETIME=30m
DATABASE_POOL_MAX_CONN_IDLE_TIME=5m
DATABASE_HEALTH_CHECK_PERIOD=1m
DATABASE_QUERY_TIMEOUT=3s
{{end}}
{{if or (eq .Preset.Name "production-api") (eq .Preset.Name "event-driven-api")}}
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_ISSUER={{.Config.Auth.AccessToken.Issuer}}
JWT_AUDIENCE={{.Config.Auth.AccessToken.Audience}}
JWT_ACCESS_TOKEN_TTL={{.Config.Auth.AccessToken.TTL}}
JWT_REFRESH_TOKEN_TTL={{.Config.Auth.RefreshToken.TTL}}
AUTH_COOKIE_SECURE=false
RATE_LIMIT_RPS={{.Config.RateLimit.RequestsPerSecond}}
RATE_LIMIT_BURST={{.Config.RateLimit.Burst}}
RATE_LIMIT_KEY={{.Config.RateLimit.Key}}
RATE_LIMIT_ENTRY_TTL={{.Config.RateLimit.EntryTTL}}
RATE_LIMIT_CLEANUP_INTERVAL={{.Config.RateLimit.CleanupInterval}}
METRICS_ENDPOINT={{.Config.Observability.Metrics.Endpoint}}
OTEL_TRACING_ENABLED={{.Config.Observability.Tracing.Enabled}}
OTEL_EXPORTER_OTLP_ENDPOINT={{.Config.Observability.Tracing.Endpoint}}
OTEL_EXPORTER_OTLP_INSECURE={{.Config.Observability.Tracing.Insecure}}
PPROF_ENABLED={{.Config.Performance.Pprof.Enabled}}
PPROF_ADDRESS={{.Config.Performance.Pprof.Address}}
{{end}}
{{if eq .Preset.Name "event-driven-api"}}
REDIS_ADDRESS=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC_PREFIX={{.Config.Messaging.TopicPrefix}}
KAFKA_CONSUMER_GROUP={{.Config.Messaging.ConsumerGroup}}
KAFKA_MAX_RETRIES={{.Config.Messaging.MaxRetries}}
KAFKA_RETRY_BACKOFF={{.Config.Messaging.RetryBackoff}}
KAFKA_DLQ_SUFFIX={{.Config.Messaging.DLQSuffix}}
OUTBOX_POLL_INTERVAL={{.Config.Outbox.PollInterval}}
OUTBOX_BATCH_SIZE={{.Config.Outbox.BatchSize}}
OUTBOX_MAX_ATTEMPTS={{.Config.Outbox.MaxAttempts}}
{{end}}
