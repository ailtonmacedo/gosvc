// Package httpserver contains HTTP delivery adapters.
package httpserver

import (
    "context"
    "fmt"
    "net/http"
    "time"

    "github.com/labstack/echo/v4"
    echomiddleware "github.com/labstack/echo/v4/middleware"
{{if .Config.OpenAPI.Enabled}}    oapivalidator "github.com/oapi-codegen/echo-middleware"
    openapi "{{.Config.Project.Module}}/internal/generated/openapi"
{{end}}    "{{.Config.Project.Module}}/internal/config"
)

type ReadinessCheck func(context.Context) error
type RouteRegistrar func(*echo.Group)

func NewRouter(cfg config.Config, readiness ReadinessCheck, register RouteRegistrar) (http.Handler, error) {
    e := echo.New()
    e.HideBanner = true
    e.Use(echomiddleware.RequestID())
    e.Use(echomiddleware.Recover())
    e.Use(echomiddleware.BodyLimit(fmt.Sprintf("%dB", cfg.HTTP.MaxBodySize)))
    e.Use(echomiddleware.Secure())
    e.GET("/health/live", func(c echo.Context) error { return c.JSON(http.StatusOK, map[string]string{"status":"alive"}) })
    e.GET("/health/ready", func(c echo.Context) error {
        ctx, cancel := context.WithTimeout(c.Request().Context(), minDuration(cfg.HTTP.ReadTimeout, 3*time.Second)); defer cancel()
        if readiness != nil { if err := readiness(ctx); err != nil { return c.JSON(http.StatusServiceUnavailable, map[string]string{"status":"not_ready"}) } }
        return c.JSON(http.StatusOK, map[string]string{"status":"ready"})
    })
{{if .Config.OpenAPI.Enabled}}    e.GET("/openapi.yaml", func(c echo.Context) error { return c.Blob(http.StatusOK, "application/yaml", openapi.RawSpec()) })
    e.GET("/docs", func(c echo.Context) error { return c.HTML(http.StatusOK, `<!doctype html><html><head><title>API Docs</title><meta charset="utf-8"></head><body><redoc spec-url="/openapi.yaml"></redoc><script src="https://cdn.redoc.ly/redoc/latest/bundles/redoc.standalone.js"></script></body></html>`) })
    spec, err := openapi.GetSwagger(); if err != nil { return nil, fmt.Errorf("load OpenAPI contract: %w", err) }; spec.Servers=nil
    api := e.Group("")
{{if .Config.OpenAPI.RequestValidation}}    api.Use(oapivalidator.OapiRequestValidatorWithOptions(spec, &oapivalidator.Options{SilenceServersWarning:true}))
{{end}}    if register != nil { register(api) }
{{else}}    if register != nil { register(e.Group("")) }
{{end}}    return e, nil
}

func minDuration(left,right time.Duration) time.Duration { if left < right { return left }; return right }
