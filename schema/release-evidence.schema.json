{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ailtonmacedo/gosvc/schema/release-evidence.schema.json",
  "title": "gosvc release evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "name",
    "version",
    "module",
    "repository",
    "commit",
    "built_at",
    "builder",
    "acceptance",
    "quality_gates",
    "reproducible"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "name": { "const": "gosvc" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
    "module": { "type": "string", "minLength": 1 },
    "repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
    "commit": { "type": "string", "minLength": 1 },
    "built_at": { "type": "string", "format": "date-time" },
    "builder": { "type": "string", "minLength": 1 },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "failed", "presets"],
      "properties": {
        "passed": { "type": "integer", "minimum": 1 },
        "failed": { "const": 0 },
        "presets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["preset", "status", "files", "resources", "architecture_files", "checks"],
            "properties": {
              "preset": { "type": "string", "minLength": 1 },
              "status": { "const": "pass" },
              "files": { "type": "integer", "minimum": 1 },
              "resources": { "type": "integer", "minimum": 0 },
              "architecture_files": { "type": "integer", "minimum": 0 },
              "checks": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "quality_gates": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "reproducible": { "const": true }
  }
}
