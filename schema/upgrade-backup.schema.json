{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gosvc.dev/schema/upgrade-backup-v1.json",
  "title": "gosvc upgrade backup metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_name",
    "project_module",
    "framework_version",
    "manifest_schema",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "project_name": {
      "type": "string",
      "minLength": 1
    },
    "project_module": {
      "type": "string",
      "minLength": 1
    },
    "framework_version": {
      "type": "string",
      "minLength": 1
    },
    "manifest_schema": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
